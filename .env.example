# Portail développeur Discord > Application
DISCORD_TOKEN=
CLIENT_ID=
# Serveur de test : les commandes y sont déployées instantanément
GUILD_ID=

# Salons dans lesquels /publier est autorisé, séparés par des virgules
ANNOUNCEMENT_CHANNEL_IDS=
# Salon privé recevant les alertes et actions de modération
MOD_LOG_CHANNEL_ID=
# Salon recevant en temps réel les modifications/suppressions de messages et l'activité vocale
ACTIVITY_LOG_CHANNEL_ID=1532081947872858132
# Salon où le bot souhaite les anniversaires
BIRTHDAY_CHANNEL_ID=1527951057538256896
# Salon dans lequel /creationanniv est autorisé
BIRTHDAY_REGISTRATION_CHANNEL_ID=1532086608231268604

# Protection anti-raid
ANTI_RAID_ENABLED=true
RAID_JOIN_LIMIT=8
RAID_WINDOW_SECONDS=15
# Âge minimum du compte en heures (0 désactive ce contrôle)
MIN_ACCOUNT_AGE_HOURS=24
# Rôle attribué aux nouveaux membres si défini (rôle de quarantaine conseillé)
QUARANTINE_ROLE_ID=

# Mots ou expressions supprimés automatiquement, séparés par des virgules
# Exemple : insulte1,expression interdite
BLOCKED_WORDS=yumyum,avril_fantome,avril_fantôme,avril fantome,avril fantôme,avril-fantome,avril-fantôme,avrilfantome,avrilfantôme
